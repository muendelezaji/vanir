# Build rule for Vanir C++ parser core.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "parser_core",
    srcs = ["parser_core.cc"],
    hdrs = ["parser_core.h"],
    copts = [
        # fexception is needed only for catching Antlr4 exceptions.
        "-fexceptions",
    ],
    features = ["-use_header_modules"],
    deps = [
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@fuzzyc//:fuzzyc_cc_function",
        "@fuzzyc//:fuzzyc_cc_module",
    ],
)

py_library(
    name = "cpp_parser",
    srcs = ["cpp_parser.py"],
    data = [
        "//vanir/language_parsers/cpp/python:parser_core.so",
        "@pybind11_abseil//pybind11_abseil:status.so",
    ],
    deps = [
        ":tree_sitter_parser",
        "//vanir/language_parsers:abstract_language_parser",
        "//vanir/language_parsers:common",
    ],
)

py_test(
    name = "cpp_parser_test",
    size = "small",
    srcs = ["cpp_parser_test.py"],
    data = ["@pybind11_abseil//pybind11_abseil:status.so"],
    deps = [
        ":cpp_parser",
        "//vanir/language_parsers:abstract_language_parser",
        "@com_google_absl_py//absl/logging",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

# Pure-Python Tree-sitter backend. FuzzyC remains available as the default.
py_library(
    name = "tree_sitter_parser",
    srcs = ["tree_sitter_parser.py"],
    deps = [
        "//vanir/language_parsers:abstract_language_parser",
        "//vanir/language_parsers:common",
        "@vanir_deps//tree_sitter",
        "@vanir_deps//tree_sitter_c",
        "@vanir_deps//tree_sitter_cpp",
    ],
)

py_test(
    name = "tree_sitter_parser_test",
    size = "small",
    srcs = ["tree_sitter_parser_test.py"],
    deps = [
        ":tree_sitter_parser",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

py_library(
    name = "equivalence",
    srcs = ["equivalence/differential.py"],
    deps = [
        "//:hasher",
        "//:normalizer",
        "//vanir/language_parsers:abstract_language_parser",
    ],
)

py_test(
    name = "parser_equivalence_test",
    size = "small",
    srcs = ["parser_equivalence_test.py"],
    data = glob([
        "equivalence/fixtures/*",
        "equivalence/*.json",
    ]),
    deps = [
        ":cpp_parser",
        ":equivalence",
        ":tree_sitter_parser",
        "//vanir/language_parsers:common",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
    ],
)

py_test(
    name = "cpp_parser_backend_test",
    size = "small",
    srcs = ["cpp_parser_backend_test.py"],
    deps = [
        ":cpp_parser",
        "//vanir/language_parsers:language_parsers",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

py_test(
    name = "differential_test",
    size = "small",
    srcs = ["equivalence/differential_test.py"],
    deps = [
        ":equivalence",
        "//vanir/language_parsers:common",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
    ],
)
